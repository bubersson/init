#!/bin/bash

source ~/init/scripts/defaults.sh

ME=$(basename "${0}")
VERSION="v0.03"

MANUAL() { cat <<DOCUMENTATION
${GREEN}identity-tool${RESET} (alias ${GREEN}s${RESET})
SSH Identity Utility ${VERSION}

${YELLOW}USAGE:${RESET}
    identity-tool <SUBCOMMAND> <PARAMS>
    identity-tool <IDENTITY>
    ${GRAY}identity-tool${RESET}
    ${GRAY}identity-tool add machine_name user 192.168.0.1${RESET}
    ${GRAY}identity-tool git identity_name${RESET}

${YELLOW}SUBCOMMANDS:${RESET}
    ${GREEN}add   ${RESET}Create new identity.
    ${GREEN}git   ${RESET}Configure git identity for current repository.
    ${GREEN}list  ${RESET}List existing identities.

DOCUMENTATION
}

function _default() {
	if [[ $# -eq 0 ]] ; then
		MANUAL
		_list
		return
	fi
	ssh $@
}

function _list() {
	echo -e "${YELLOW}AVAILABLE IDENTITIES:${RESET}"
	sed -n 's/.*Host /    /p' ~/.ssh/config
	echo -e ""
}

function _add() {
	if [[ $# -ne 4 ]] ; then
		echo -e "${CROSS} ${RED}ERROR: Wrong number of params to 'add'${RESET}"
		echo -e "Expected format: ${WHITE}identity-tool add machine_name user 192.168.0.1${RESET}"
		return
	fi
    local has_error=false

	local SSH_CONNECTION_NAME=$2
	local SSH_LOGIN_USER=$3
	local SSH_LOGIN_HOST=$4
	local SSH_LOGIN_EMAIL="my@email.com"

	# Generate SSH key
	echo -e "$INFO Generating ssh key"
	mkdir -p ~/.ssh
	ssh-keygen -t ed25519 -C $SSH_LOGIN_EMAIL -N "" -f "$HOME/.ssh/$SSH_CONNECTION_NAME" || has_error=true

	# Add new connection to ~/.ssh/config
	echo -e "$INFO Adding new connection to ~/.ssh/config"
	touch ~/.ssh/config
	chmod 600 ~/.ssh/config
	echo -e "\nHost "$SSH_CONNECTION_NAME >> ~/.ssh/config
	echo -e "	HostName "$SSH_LOGIN_HOST >> ~/.ssh/config
	echo -e "	User "$SSH_LOGIN_USER >> ~/.ssh/config
	echo -e "	AddKeysToAgent yes" >> ~/.ssh/config
	echo -e "	IdentityFile ~/.ssh/"$SSH_CONNECTION_NAME >> ~/.ssh/config
	echo -e " " >> ~/.ssh/config

	echo -e "$INFO Copying public key to the target machine"
	ssh-copy-id -i "$HOME/.ssh/$SSH_CONNECTION_NAME" "${SSH_LOGIN_USER}@${SSH_LOGIN_HOST}" || has_error=true

	if $has_error ; then
        echo -e "$CROSS Function returned errors"
    else
    	echo -e "$TICK DONE. To log in use: ${WHITE}identity-tool ${SSH_CONNECTION_NAME}${RESET}"
    fi
}

function _git() {
	if [[ $# -ne 2 ]] ; then
		echo -e "${CROSS} ${RED}ERROR: Wrong number of params to 'git'${RESET}"
		echo -e "Expected format: ${WHITE}identity-tool git identity_name${RESET}"
		return
	fi
	local has_error=false

	local SOME_NAME=$2

	if [[ ! "$SOME_NAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
		echo -e "${CROSS} ${RED}ERROR: Invalid identity name: ${WHITE}${SOME_NAME}${RESET}"
		echo -e "Identity name must start with an alphanumeric character and contain only letters, numbers, dots, dashes, or underscores."
		return
	fi

	local PUB_KEY_FILE="$HOME/.ssh/$SOME_NAME.pub"

	if [ ! -d .git ]; then
		echo -e "$INFO Initializing git repository"
		git init || has_error=true
	fi

	if [ ! -f "$PUB_KEY_FILE" ]; then
		echo -e "${CROSS} ${RED}ERROR: Public key file not found: ${WHITE}${PUB_KEY_FILE}${RESET}"
		return
	fi

	local SOME_EMAIL=$(awk '{print $3}' "$PUB_KEY_FILE" | head -n 1)
	if [ -z "$SOME_EMAIL" ]; then
		echo -e "${CROSS} ${RED}ERROR: Could not extract email from ${WHITE}${PUB_KEY_FILE}${RESET}"
		return
	fi

	git config user.name "$SOME_NAME" || has_error=true
	git config user.email "$SOME_EMAIL" || has_error=true
	git config user.signingkey "$HOME/.ssh/$SOME_NAME.pub" || has_error=true
	git config commit.gpgsign true || has_error=true
	git config tag.gpgsign true || has_error=true
	git config gpg.format ssh || has_error=true
	git config gpg.ssh.allowedSignersFile "$HOME/.ssh/allowed_signers" || has_error=true

	if $has_error ; then
		echo -e "$CROSS Function returned errors"
	else
		echo -e "$TICK DONE. Git identity set to ${WHITE}${SOME_NAME}${RESET} <${SOME_EMAIL}>"
	fi
}

case $1 in
	--help|-h)  MANUAL          ; exit 0 ;;
	list)    	_list     	   ; exit 0 ;;
	add)        _add $@        ; exit 0 ;;
	git)        _git $@        ; exit 0 ;;
	*)          _default $@    ; exit 0 ;;
esac

